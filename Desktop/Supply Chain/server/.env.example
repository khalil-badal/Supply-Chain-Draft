# Copy this file to .env and fill in real values before running the server.

# SQLite database file path (relative to server/)
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs. Generate a long random string for real deployments.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the Express API listens on. The Vite dev server proxies /api to this port.
PORT=4000

# Origin allowed to send credentialed requests (the Vite dev server).
CLIENT_ORIGIN="http://localhost:3000"

# SMTP placeholders - not used yet. Nodemailer currently logs emails to the
# console instead of sending them. Fill these in and swap the transport in
# src/services/mailer.ts to send real email later.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Microgenesis Supply Chain Portal <no-reply@microgenesis.example>"
