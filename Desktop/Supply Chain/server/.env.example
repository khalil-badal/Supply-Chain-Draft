# Copy this file to .env and fill in real values before running the server.

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite for local dev; PostgreSQL for production (set in render.yaml)
DATABASE_URL="file:./dev.db"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"

# ─── Microsoft Azure AD SSO (optional) ──────────────────────────────────────
# Register an app in Microsoft Entra ID and fill in these values.
# Leave blank to disable Microsoft login (email+password login still works).
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID="common"
# APP_URL must match the redirect URI registered in Azure (no trailing slash)
APP_URL="http://localhost:3000"

# ─── Email ───────────────────────────────────────────────────────────────────
# Priority: Graph API (when Azure vars above are set) > SMTP > mock (console log)
# For M365 Graph email, the Azure app needs Mail.Send application permission.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Microgenesis Supply Chain Portal <no-reply@microgenesis.example>"
